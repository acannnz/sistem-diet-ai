# Salin file ini menjadi .env lalu isi nilainya.

# API AI (9router, format OpenAI-compatible)
AI_BASE_URL=http://IP_SERVER_9ROUTER:20128/v1
AI_API_KEY=isi_api_key_9router
# Nama combo di 9router. Disarankan buat combo khusus untuk scan
# (strategi Fallback, isi model vision seperti gemini flash) supaya hasil JSON konsisten.
AI_VISION_MODEL=scan
AI_CHAT_MODEL=free

# Akun: username:PIN dipisah koma. Ganti PIN-nya!
USERS=aku:1234,pacar:5678

# String acak panjang untuk mengamankan cookie login.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_string_acak

# Lokasi file database
DB_PATH=data/diet.db

# Zona waktu untuk menentukan "hari ini"
TIMEZONE=Asia/Makassar
